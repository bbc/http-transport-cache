{
  "name": "@bbc/http-transport-cache",
  "version": "5.0.0",
  "description": "Caching middleware",
  "main": "index.js",
  "scripts": {
    "test": "jest && pnpm run lint",
    "coverage": "jest --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bbc/http-transport-cache.git"
  },
  "bugs": {
    "url": "https://github.com/bbc/http-transport-cache/issues"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "keywords": [
    "http-transport",
    "caching",
    "http",
    "client",
    "middleware"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@bbc/http-transport": "^5.0.1",
    "@bbc/http-transport-to-error": "^2.2.0",
    "@biomejs/biome": "2.5.15",
    "jest": "^30.5.2",
    "nock": "^13.0.4",
    "sinon": "^9.0.3"
  },
  "dependencies": {
    "@hapi/catbox": "^12.1.1",
    "@hapi/catbox-memory": "^6.0.1",
    "@hapi/wreck": "^18.1.2",
    "bluebird": "^3.7.2"
  },
  "peerDependencies": {
    "@bbc/http-transport": "^5.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.js"
    ],
    "forceExit": true
  }
