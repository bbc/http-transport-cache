{
  "name": "@bbc/http-transport-cache",
  "version": "5.0.0",
  "description": "Caching middleware",
  "main": "index.js",
  "scripts": {
    "test": "jest && pnpm run lint",
    "coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bbc/http-transport-cache.git"
  },
  "bugs": {
    "url": "https://github.com/bbc/http-transport-cache/issues"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "keywords": [
    "http-transport",
    "caching",
    "http",
    "client",
    "middleware"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@bbc/http-transport": "^4.3.0",
    "@bbc/http-transport-to-error": "^2.2.0",
    "eslint": "^8.54.0",
    "eslint-config-iplayer": "^9.1.0",
    "jest": "^30.5.2",
    "nock": "^13.0.4",
    "sinon": "^9.0.3"
  },
  "dependencies": {
    "@hapi/catbox": "^12.1.1",
    "@hapi/catbox-memory": "^6.0.1",
    "@hapi/wreck": "^18.0.1",
    "bluebird": "^3.7.2",
    "lodash": "^4.17.20"
  },
  "peerDependencies": {
    "@bbc/http-transport": "^3 || ^4"
  },
  "eslintConfig": {
    "extends": "iplayer",
    "parserOptions": {
      "ecmaVersion": "latest"
    },
    "overrides": [
      {
        "files": [
          "test/**/*.js"
        ],
        "env": {
          "jest": true
        },
        "rules": {
          "listeners/no-inline-function-event-listener": "off",
          "listeners/no-missing-remove-event-listener": "off"
        }
      }
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.js"
    ],
    "forceExit": true
  }
}